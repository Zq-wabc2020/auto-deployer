# deployd 配置
#
# 配置以流水线（pipelines）组织工作项：每个工作项由多个 stage 节点组成。
# - git 节点决定 webhook 匹配（url/branch 必须是字面量，不能写 ${...} 引用）
# - shell 节点执行构建/部署命令
# - email 节点发送通知；when 为空=主流程成功时执行
# - cleanup 节点清理工作空间
# 节点 when 取值：空（主流程）/ failure（主流程失败时）/ always（无论成败）

# ─────────────── 监听地址 ───────────────
server:
  host: "0.0.0.0"          # 0.0.0.0=监听所有网卡(允许外部访问)；127.0.0.1=仅本机可访问
  port: 9527

# ─────────────── Webhook ───────────────
webhook:
  secret: ""               # GitHub/Gitee webhook 签名校验密钥（预留字段，暂未启用）

# ─────────────── 邮件通知 ───────────────
# SMTP 与 Resend 二选一；都不配置则不发送通知
smtp:
  host: "smtp.qq.com"
  port: 465
  username: "your-email@qq.com"
  token: "your-smtp-authorization-code"   # SMTP 授权码，非登录密码
  tls: true                               # STARTTLS 或 SSL 加密
resend:
  api_key: "re_xxxxxxxxxxxxxxxxxxxxx"     # 获取：https://resend.com/api-keys
  from: "deployd <onboarding@your-domain.com>"
notifications:
  to:                      # 额外通知收件人（代码提交作者始终作为默认收件人）
    - "admin@example.com"

# ─────────────── 工作项列表 ───────────────
pipelines:
  - name: "my-app"
    workspace: "/opt/deployd/apps/my-app"   # 代码克隆与工作目录
    timeout: "45m"                          # 可选：整条流水线总超时(默认 30m)
    env:                                    # 可选：环境变量（${env.xxx} 引用）
      JAVA_OPTS: "-Xms100m -Xmx128m"
    stages:
      - name: 拉取代码
        type: git
        params:
          url: "https://github.com/user/repo.git"   # Git 仓库地址（webhook 匹配用字面量）
          branch: ["main"]                          # 部署分支（webhook 匹配用字面量）
      - name: 构建
        type: shell
        params:
          sh: "mvn package -DskipTests"       # 构建命令（shell），支持 && 串联
      - name: 部署
        type: shell
        params:
          sh: "systemctl restart my-app"      # 部署命令（纯启动/重启，不要写 nohup/&）
      - name: 成功通知
        type: email
        params:
          subject: "${system.name} 部署成功 ${system.commit}"
          body: "分支 ${system.branch} 由 ${system.author} 触发"
      - name: 失败通知
        type: email
        when: failure
        params:
          subject: "${system.name} 部署失败于 ${system.failed_stage}"
          body: "${system.message}"
      - name: 清理工作空间
        type: cleanup
        when: always
